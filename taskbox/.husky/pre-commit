#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

cd taskbox

echo "Running pre-commit checks..."

# Run lint-staged
/opt/homebrew/bin/node .yarn/releases/yarn-4.9.2.cjs lint-staged

# Check if lint-staged passed
if [ $? -ne 0 ]; then
    echo "Lint-staged checks failed! Commit blocked."
    exit 1
fi

# Run tests
echo "Running tests..."
/opt/homebrew/bin/node .yarn/releases/yarn-4.9.2.cjs test:ci

# Check if tests passed
if [ $? -ne 0 ]; then
    echo "Tests failed! Commit blocked."
    exit 1
fi

echo "All pre-commit checks passed!"
